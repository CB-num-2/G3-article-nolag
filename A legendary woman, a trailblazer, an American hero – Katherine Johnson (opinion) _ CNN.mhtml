@charset "utf-8";

.ns-wu7gg-l-banner3 { opacity: 1; position: relative; }

.ns-wu7gg-l-banner3 .tag { display: inline-flex; }

.ns-wu7gg-l-banner3 .tag-animation { animation-name: fade-in; animation-del=
ay: 0.6s; animation-duration: 0.48s; animation-fill-mode: forwards; animati=
on-timing-function: cubic-bezier(0.4, 0, 0.2, 1); opacity: 0; }

.ns-wu7gg-l-banner3 .tag-staggered-animation { animation-name: fade-in; ani=
mation-duration: 0.5s; animation-fill-mode: forwards; animation-timing-func=
tion: cubic-bezier(0.4, 0, 0.2, 1); opacity: 0; }

@media (prefers-reduced-motion) {
  .ns-wu7gg-l-banner3 .tag-staggered-animation { animation-name: none; opac=
ity: 1; }
}

@keyframes fade-in {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.ns-wu7gg-l-banner3 .still-interested-tag:has(~ .scrim-price-background), .=
still-interested-tag:has(~ .price-background) { top: 3px; bottom: auto; pad=
ding: 3px 0px 6px; }

@supports (-webkit-backdrop-filter:blur(4px)) or (backdrop-filter:blur(4px)=
) {
  .ns-wu7gg-l-banner3 .backdrop-style { backdrop-filter: blur(4px); backgro=
und-color: rgba(255, 255, 255, 0.6); }
}

@keyframes slide-up-animation {=20
  0% { transform: translateY(0px); }
  100% { transform: translateY(0px); }
}

.ns-wu7gg-l-banner3 .price-overlay-animation { animation-name: slide-up-ani=
mation; animation-duration: 0.4s; animation-fill-mode: both; animation-timi=
ng-function: ease-in-out; }

@media (prefers-reduced-motion) {
  .ns-wu7gg-l-banner3 .price-overlay-animation { animation-name: none; }
}

.product-box:hover { box-shadow: rgba(60, 64, 67, 0.3) 0px 1px 2px 0px, rgb=
a(60, 64, 67, 0.15) 0px 1px 3px 1px; transition: opacity 0.24s cubic-bezier=
(0.4, 0, 0.2, 1); }

.product-box:hover .price-background { display: block; }

@keyframes maximal-intro-wiggle-animation {=20
  0% { transform: rotate(17deg); }
  85% { transform: rotate(-3deg); }
  100% { transform: rotate(0deg); }
}

@keyframes maximal-fade-in-animation {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes highlight-animation {=20
  0% { box-shadow: rgba(112, 112, 112, 0.15) 0px 0px 8px; }
  15% { box-shadow: rgba(60, 64, 67, 0.7) 0px 2px 4px 1px, rgba(60, 64, 67,=
 0.35) 0px 2px 6px 2px; }
  30% { box-shadow: rgba(112, 112, 112, 0.15) 0px 0px 8px; }
  100% { box-shadow: rgba(112, 112, 112, 0.15) 0px 0px 8px; }
}

@keyframes wiggle-pendulum {=20
  0%, 100% { transform: rotate(0deg); }
  11.7% { transform: rotate(-3.5deg); }
  25% { transform: rotate(3.5deg); }
  45% { transform: rotate(-2.9deg); }
  58.3% { transform: rotate(2.9deg); }
  78.3% { transform: rotate(-2.3deg); }
  91.7% { transform: rotate(2.3deg); }
}

@keyframes cenlo-close-opacity-animation {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.viewport-entered .ns-wu7gg-l-banner3 .brand-name-app-store-info { animatio=
n: 9s linear 0s 4 normal none running hideDiv; }

.viewport-entered .ns-wu7gg-l-banner3 .brand-name-app-headline { animation:=
 9s linear 0s 4 normal none running showDiv; }

@media (prefers-reduced-motion) {
  .viewport-entered .ns-wu7gg-l-banner3 .brand-name-app-store-info, .viewpo=
rt-entered .ns-wu7gg-l-banner3 .brand-name-app-headline { animation-name: n=
one; }
}

@keyframes hideDiv {=20
  0%, 45%, 100% { opacity: 1; }
  55%, 95% { opacity: 0; }
}

@keyframes showDiv {=20
  0%, 45%, 100% { opacity: 0; }
  55%, 95% { opacity: 1; }
}

.ns-wu7gg-e-0 { background-color: rgb(255, 255, 255); }

